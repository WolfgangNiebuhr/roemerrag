{
  "format_version": 1,
  "name": "snowflake-arctic-embed-v2",
  "embedding_set_id": "snowflake-arctic-embed-v2",
  "chunking": {
    "strategy": "recursive",
    "parameters": {"size": 1000, "overlap": 150, "separators": ["\n\n", ".\n", ". "]}
